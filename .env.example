# Copy this file to .env for local development, or set these as
# environment variables in your hosting provider's dashboard for production.

# A long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-something-random

# Where the SQLite database file lives. On Render/Railway, point this at a
# path inside your mounted persistent disk, e.g. /var/data/tgn.db
DATABASE_PATH=instance/tgn.db

PORT=5000
FLASK_DEBUG=0

# Outbound email for the Targeted Video pipeline's video-delivery step
# (sending the finished video link to an external recipient). Uses Gmail's
# SMTP relay with an app-specific password — NOT your regular Gmail
# password. Generate one at: Google Account -> Security -> 2-Step
# Verification -> App passwords. Leave unset to skip real sending (the
# task/recipient/deadline still get recorded; you'd just send the link
# yourself).
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# Push notifications (phone reminders for posts due today, with a
# suggested best time to post). Generate a keypair with:
#   python3 scripts/generate_vapid_keys.py
# Paste the two values it prints below. VAPID_CLAIM_EMAIL just identifies
# who's sending, to the push services (Apple/Google/Mozilla) — any
# address you check works. Leave all three unset to skip push entirely
# (the rest of the app runs fine without them).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# Shared secret the daily reminder cron job sends as an X-Cron-Secret
# header (or ?token= for a quick manual test) to prove it's allowed to
# trigger /internal/send-post-reminders. Generate one the same way as
# SECRET_KEY above. Required for the reminder cron to do anything — the
# endpoint refuses to run with this unset.
CRON_SECRET=

# Local wall-clock timezone used only to decide "is it today" and to
# label the recommended best-posting-time in a reminder (e.g. "11:00 AM")
# — an IANA name like Africa/Johannesburg, America/New_York, America/Chicago,
# America/Denver, America/Los_Angeles. Defaults to Africa/Johannesburg
# (Jodie's own timezone, no DST) if unset — set this explicitly anyway so
# it's never left to the fallback.
LOCAL_TIMEZONE=Africa/Johannesburg
